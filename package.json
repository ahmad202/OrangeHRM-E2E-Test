{
  "name": "orangehrm-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E suite for the OrangeHRM open-source demo",
  "scripts": {
    "test": "playwright test --project=setup --project=chromium",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=setup --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=setup --project=chromium --debug",
    "test:smoke": "playwright test --project=setup --project=chromium --grep @smoke",
    "test:journeys": "playwright test --project=setup --project=chromium --grep @journey",
    "test:workflows": "cross-env E2E_ALLOW_WRITES=1 playwright test --project=setup --project=chromium --grep @workflow",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.0"
  }
}
